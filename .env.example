# Leave both blank to run in offline/mock mode: no external calls, deterministic
# demo data from MockRoutingProvider / MockWeatherProvider. Great for local dev
# and for this portfolio project's automated tests.
ORS_API_KEY=
OWM_API_KEY=

CORS_ORIGINS=http://localhost:3000

# Local MongoDB storage for generated itineraries and itinerary search.
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=RiderTrail
